@model NguyenDucHuy_241224478_DTM2023.Models.HangHoa

<div class="content">
    <div class="content_top">
        <div class="heading">
            <h3>Nguyễn Văn An</h3>
            <h4 style="margin-top: 5px; font-weight: bold;">Thêm Hàng Hóa Mới</h4>
        </div>
        <div class="clear"></div>
    </div>

    <form asp-controller="Home" asp-action="Create" method="post" style="margin-top: 15px;">
        <div asp-validation-summary="ModelOnly" style="color: red;"></div>

        <div style="margin-bottom: 12px;">
            <label asp-for="MaLoai">MaLoai</label><br />
            <select asp-for="MaLoai" asp-items="ViewBag.MaLoai" style="padding: 4px; width: 200px;"></select>
            <span asp-validation-for="MaLoai" style="color: red;"></span>
        </div>

        <div style="margin-bottom: 12px;">
            <label asp-for="TenHang">TenHang</label><br />
            <input asp-for="TenHang" style="padding: 4px; width: 200px;" />
            <span asp-validation-for="TenHang" style="color: red;"></span>
        </div>

        <div style="margin-bottom: 12px;">
            <label asp-for="Gia">Gia</label><br />
            <input asp-for="Gia" style="padding: 4px; width: 200px;" />
            <span asp-validation-for="Gia" style="color: red;"></span>
        </div>

        <div style="margin-bottom: 12px;">
            <label asp-for="Anh">Anh</label><br />
            <input asp-for="Anh" style="padding: 4px; width: 200px;" />
            <span asp-validation-for="Anh" style="color: red;"></span>
        </div>

        <input type="submit" value="Create" style="padding: 5px 15px; cursor: pointer;" />
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}